# --- Required for a real deployment ---

# Set by Vercel automatically once you create a Blob store and connect it
# to this project (Storage tab -> Create Database -> Blob). Without this,
# the app falls back to writing local_blob_store/ on disk, which will NOT
# persist correctly on Vercel's serverless functions.
BLOB_READ_WRITE_TOKEN=

# Set by Vercel automatically once you add a Postgres integration (Storage
# tab -> Create Database -> Postgres, e.g. via Neon). Without this, activity
# logging falls back to a local SQLite file, which will NOT persist
# correctly on Vercel's serverless functions (it'll just silently not log).
DATABASE_URL=

# A real random secret for signing session cookies in production.
SECRET_KEY=change-me-to-a-long-random-string
